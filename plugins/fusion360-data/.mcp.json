{
  "mcpServers": {
    "fusion360-data": {
      "type": "streamable-http",
      "url": "https://developer.api.autodesk.com/fusion/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "baseScopes": [],
            "defaultScopes": [
              "mcp:read",
              "mcp:write",
              "offline_access"
            ],
            "oidcEnabled": false,
            "authorizationUrl": "https://developer.api.autodesk.com/mcpauth/v1/authorize",
            "tokenUrl": "https://developer.api.autodesk.com/mcpauth/v1/token",
            "authorizationServerBase": "https://developer.api.autodesk.com/mcpauth",
            "resource": "https://developer.api.autodesk.com/fusion/mcp",
            "oidcScopesSupported": []
          }
        }
      }
    }
  }
}
